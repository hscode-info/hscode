{
  "baseUrl": "https://hscode.info/api/v1",
  "headers": {
    "Authorization": "Bearer {{connection.apiKey}}",
    "Accept": "application/json"
  },
  "response": {
    "error": {
      "message": "[{{statusCode}}] {{body.error}}: {{body.message}}"
    }
  },
  "log": {
    "sanitize": ["request.headers.authorization"]
  }
}
