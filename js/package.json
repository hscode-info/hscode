{
	"name": "@hscode/sdk",
	"version": "0.1.1",
	"description": "HS code API, SDK and CLI for the EU customs tariff (TARIC): classify products into CN codes and get import duties from Node.js, the shell or an AI agent.",
	"homepage": "https://hscode.info/en/developers",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hscode-info/hscode.git",
		"directory": "js"
	},
	"license": "MIT",
	"keywords": [
		"hs code",
		"hs code api",
		"hs code lookup",
		"hs code classification",
		"taric",
		"taric api",
		"cn code",
		"combined nomenclature",
		"eu customs tariff",
		"customs",
		"tariff",
		"import duty",
		"customs duty",
		"customs duty calculator",
		"zolltarifnummer",
		"bti",
		"ebti",
		"mcp",
		"mcp server",
		"ai agent",
		"typescript",
		"cli",
		"csv classification"
	],
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"bin": {
		"hscode": "dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"spec": "node scripts/fetch-spec.mjs && npm run types",
		"types": "openapi-typescript ../openapi.json -o src/schema.ts",
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"test": "npm run build && node --test \"test/*.test.mjs\"",
		"prepack": "npm run build"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"openapi-typescript": "^7.0.0",
		"typescript": "^5.6.0"
	}
}
